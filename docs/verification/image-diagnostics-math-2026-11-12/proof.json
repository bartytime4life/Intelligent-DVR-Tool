{"argument":["Each response is a linear map A from nine luma samples into R^2.","The squared Euclidean norm ||A p||^2 is convex in p.","Every p in the continuous cube [0,255]^9 is a convex combination of its binary vertices.","Jensen inequality bounds every cube response by the maximum over those 512 vertices.","Exact integer enumeration attains 20*255^2; therefore 255*sqrt(20) is the tight bound.","The centre coefficient is zero in both kernels, explaining the doubled maximizer count.","A region mean of nonnegative magnitudes is bounded by the same maximum; this is not RMS."],"binary_patches":512,"distinct_noncentre_vertex_patches":256,"kernel_x":[-1,0,1,-2,0,2,-1,0,1],"kernel_y":[-1,-2,-1,0,0,0,1,2,1],"maximizer_count_including_free_centre":16,"maximizers":[{"bits":15,"gx":-510,"gy":-1020,"patch":[255,255,255,255,0,0,0,0,0],"squared":1300500},{"bits":31,"gx":-510,"gy":-1020,"patch":[255,255,255,255,255,0,0,0,0],"squared":1300500},{"bits":39,"gx":510,"gy":-1020,"patch":[255,255,255,0,0,255,0,0,0],"squared":1300500},{"bits":55,"gx":510,"gy":-1020,"patch":[255,255,255,0,255,255,0,0,0],"squared":1300500},{"bits":75,"gx":-1020,"gy":-510,"patch":[255,255,0,255,0,0,255,0,0],"squared":1300500},{"bits":91,"gx":-1020,"gy":-510,"patch":[255,255,0,255,255,0,255,0,0],"squared":1300500},{"bits":201,"gx":-1020,"gy":510,"patch":[255,0,0,255,0,0,255,255,0],"squared":1300500},{"bits":217,"gx":-1020,"gy":510,"patch":[255,0,0,255,255,0,255,255,0],"squared":1300500},{"bits":294,"gx":1020,"gy":-510,"patch":[0,255,255,0,0,255,0,0,255],"squared":1300500},{"bits":310,"gx":1020,"gy":-510,"patch":[0,255,255,0,255,255,0,0,255],"squared":1300500},{"bits":420,"gx":1020,"gy":510,"patch":[0,0,255,0,0,255,0,255,255],"squared":1300500},{"bits":436,"gx":1020,"gy":510,"patch":[0,0,255,0,255,255,0,255,255],"squared":1300500},{"bits":456,"gx":-510,"gy":1020,"patch":[0,0,0,255,0,0,255,255,255],"squared":1300500},{"bits":472,"gx":-510,"gy":1020,"patch":[0,0,0,255,255,0,255,255,255],"squared":1300500},{"